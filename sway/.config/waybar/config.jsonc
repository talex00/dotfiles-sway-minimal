{
    "layer": "top",
    "position": "left",
    "width": 25,
    "spacing": 4,

    "modules-left": ["sway/workspaces"],
    "modules-center": ["sway/window"],
    "modules-right": ["sway/language", "tray", "pulseaudio", "clock", "battery"],

    "sway/workspaces": {
        "all-outputs": true,
        "disable-scroll": true
    },

    // rotate заменяет прежний custom/window со скриптом и опросом раз в секунду.
    "sway/window": {
        "format": "{title}",
        "max-length": 15,
        "rotate": 90
    },

    "sway/language": {
        "format-en": "US",
        "format-ru": "RU"
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "--",
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "{:%H\n%M}",
        "format-alt": "{:%d\n%m}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}"
    }
}
