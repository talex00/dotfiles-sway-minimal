{
    "layer": "top",
    "spacing": 4,

    // Динамические параметры (позиция, размеры, margins, clock, sway/window)
    // генерируются scripts/look.sh в state.json:
    "include": "~/.config/waybar/state.json",

    "modules-left": ["custom/arch", "sway/workspaces"],
    "modules-center": ["sway/window"],
    "modules-right": ["keyboard-state", "sway/language", "tray", "pulseaudio", "custom/notification", "clock", "battery"],

    "custom/arch": {
        "format": "",
        "tooltip": false
    },

    "keyboard-state": {
        "capslock": true,
        "format": "{icon}",
        "format-icons": {
            "locked": "CAPS",
            "unlocked": ""
        }
    },

    "sway/workspaces": {
        "all-outputs": true,
        "disable-scroll": true
    },

    "sway/language": {
        "format-en": "US",
        "format-ru": "RU"
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "--",
        "on-click": "pavucontrol"
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}"
    }
}
