{
    "layer": "top",
    "spacing": 2,

    // Позицию, размер и margins панели переписывает на месте scripts/look.sh —
    // блок между маркерами ниже (тот же приём, что у fuzzel: сначала
    // отцепляется stow-симлинк, дальше файл локальный). include для этого не
    // подходит: waybar 0.9.24 из noble падает на старте, если включаемого
    // файла нет. Значения здесь — фолбэк: вертикальная панель слева (тема ice).
    // === look.sh:bar ===
    "position": "top",
    "height": 32,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    // === конец look.sh:bar ===

    "modules-left": ["custom/ubuntu", "sway/workspaces"],
    "modules-center": ["sway/window"],
    "modules-right": ["sway/language", "keyboard-state", "tray", "pulseaudio", "custom/notification", "clock", "battery"],

    "custom/ubuntu": {
        "format": "  пуск",
        "on-click": "~/.config/sway/scripts/helpers/fuzzel-menu.sh",
        "tooltip": false
    },

    "sway/workspaces": {
        "all-outputs": true,
        "disable-scroll": true
    },

    // Заголовок окна и часы зависят от раскладки панели (вертикальная /
    // горизонтальная), поэтому их блоки тоже переписывает scripts/look.sh.
    // rotate заменяет прежний custom/window со скриптом и опросом раз в секунду.
    // === look.sh:window ===
    "sway/window": {
        "format": "{title}",
        "max-length": 35,
        "rotate": 0
    },
    // === конец look.sh:window ===

    "sway/language": {
        "format-en": "US",
        "format-ru": "RU"
    },

    "keyboard-state": {
        "numlock": false,
        "capslock": true,
        "scrolllock": false,
        "format": {
            "capslock": "{icon}"
        },
        "format-icons": {
            "locked": "⇪",
            "unlocked": ""
        }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "--",
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    // Виджет уведомлений swaync: счётчик, ЛКМ — центр уведомлений,
    // ПКМ — «Не беспокоить». -swb — режим waybar у swaync-client.
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup>●</sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup>●</sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup>●</sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup>●</sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    // === look.sh:clock ===
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d.%m.%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    // === конец look.sh:clock ===

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}"
    }
}
