{
    "layer": "top",
    "spacing": 4,

    // Динамические параметры (позиция, размеры, margins, clock, sway/window)
    // генерируются scripts/look.sh в state.json:
    "include": "~/.config/waybar/state.json",

    "modules-left": ["custom/arch", "sway/workspaces"],
    "modules-center": ["sway/window"],
    "modules-right": ["keyboard-state", "sway/language", "tray", "pulseaudio", "clock", "battery"],

    "custom/arch": {
        "format": "",
        "tooltip": false
    },

    "keyboard-state": {
        "capslock": true,
        "format": "{icon}",
        "format-icons": {
            "locked": "CAPS",
            "unlocked": ""
        }
    },

    "sway/workspaces": {
        "all-outputs": true,
        "disable-scroll": true
    },

    "sway/language": {
        "format-en": "US",
        "format-ru": "RU"
    },

    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "--",
        "on-click": "pavucontrol"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}"
    }
}
