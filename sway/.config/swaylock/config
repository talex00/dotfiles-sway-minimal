# swaylock-effects. Обои те же, что на рабочем столе, — их подставляет
# scripts/lock.sh, потому что в этом конфиге нет ни подстановки команд, ни ~.
#
# Размеры связаны жёстко, отдельной опции для даты не существует:
#   время — font-size (155);
#   дата  — indicator-radius / 6, то есть ≈ 50;
#   бокс раскладки и надписи verifying / wrong / cleared — тоже font-size.
# Бокс раскладки рисуется под кольцом и только во время ввода пароля,
# поэтому его ширина часам не мешает. А вот verifying рисуется внутри круга и
# при таком кегле шире него — поэтому он скрыт прозрачным цветом.

indicator
clock
timestr=%H:%M
datestr=%a, %-d %B
font=Inter
font-size=155
indicator-radius=300
indicator-thickness=3
scaling=fill

ring-color=ffffff
inside-color=00000066
text-color=ffffff
line-color=00000000
separator-color=00000000

key-hl-color=00ff99
bs-hl-color=ff0000

# Бокс текущей раскладки под кольцом: та же подложка и белый текст, без рамки.
layout-bg-color=00000066
layout-border-color=00000000
layout-text-color=ffffff

# text-*-color прозрачные: слово verifying рисуется размером font-size и при
# таких часах вылезает за круг. Состояние и так читается по цвету кольца.
ring-clear-color=ffffff
inside-clear-color=00000066
text-clear-color=00000000
line-clear-color=00000000

ring-ver-color=00ff99
inside-ver-color=00000066
text-ver-color=00000000
line-ver-color=00000000

ring-wrong-color=ff0000
inside-wrong-color=00000066
text-wrong-color=00000000
line-wrong-color=00000000
