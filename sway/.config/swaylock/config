# swaylock-effects. Обои те же, что на рабочем столе, — их подставляет
# scripts/lock.sh, потому что в этом конфиге нет ни подстановки команд, ни ~.
#
# Пропорции времени и даты задаются двумя разными способами:
#   время — font-size;
#   дата  — indicator-radius / 6, отдельной опции для неё в swaylock-effects нет.
# Поэтому дату подгоняем не размером, а форматом datestr: %a вместо %A даёт
# строку примерно на ширину времени, а не вдвое шире его.

indicator
clock
timestr=%H:%M
datestr=%a, %-d %B
font=Inter
font-size=120
indicator-radius=280
indicator-thickness=3
scaling=fill

ring-color=ffffff
inside-color=00000066
text-color=ffffff
line-color=00000000
separator-color=00000000

key-hl-color=00ff99
bs-hl-color=ff0000

ring-clear-color=ffffff
inside-clear-color=00000066
text-clear-color=ffffff
line-clear-color=00000000

ring-ver-color=00ff99
inside-ver-color=00000066
text-ver-color=00ff99
line-ver-color=00000000

ring-wrong-color=ff0000
inside-wrong-color=00000066
text-wrong-color=ff0000
line-wrong-color=00000000
