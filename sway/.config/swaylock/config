# Экран блокировки: обои рабочего стола + круг-индикатор по центру.
# Нужен swaylock-effects: indicator, clock, timestr, datestr — его опции.
# Сами обои подставляет scripts/lock.sh: в конфиге нет подстановки команд.

indicator
clock
timestr=%H:%M
datestr=%A, %-d %B
font=Inter
font-size=48
indicator-radius=140
indicator-thickness=3
scaling=fill

# Кольцо белое, внутри чёрный с большой прозрачностью — чтобы время
# читалось на любых обоях. Прозрачность — последние две цифры: 66 ≈ 40%, 99 ≈ 60%.
ring-color=ffffff
inside-color=00000066
text-color=ffffff
line-color=00000000
separator-color=00000000

# Ввод — зелёный, стирание — красный.
key-hl-color=00ff99
bs-hl-color=ff0000

# У swaylock нет наследования цветов: каждое состояние описывается целиком,
# иначе вылезают дефолтные оранжевый и синий.
ring-clear-color=ffffff
inside-clear-color=00000066
text-clear-color=ffffff
line-clear-color=00000000

ring-ver-color=00ff99
inside-ver-color=00000066
text-ver-color=00ff99
line-ver-color=00000000

ring-wrong-color=ff0000
inside-wrong-color=00000066
text-wrong-color=ff0000
line-wrong-color=00000000
