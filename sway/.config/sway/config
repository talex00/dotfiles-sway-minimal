# Sway. Минималистичное окружение: светлая тема, нулевые гэпы, тонкие рамки.
# Ubuntu 24.04. Внимание: sway не понимает комментарии в конце строки — только отдельной строкой.

# Настройки мониторов не лежат в git: sway читает машинно-локальный файл
# (его пишет wdisplays, см. README). Глоб нужен не для задания раскладки, а
# чтобы reload её не сбрасывал: без output-директив sway при reload включает
# автоконфигурацию wlroots (все мониторы on, лучший mode, scale 1).
# Глоб: если файлов нет, sway не ругается.
include ~/.config/sway/monitor*

# Воркспейсы машинно-специфичны и в git не лежат. Глоб: если файла нет, sway не ругается.
include ~/.config/sway/workspace*

# Обои рабочего стола: генерируется scripts/wallpaper.sh (output * bg ...). Глоб: если файла нет, sway не ругается.
include ~/.config/sway/wallpaper*.conf

set $mod     Mod4
set $term    foot
set $files   thunar
set $scripts ~/.config/sway/scripts
set $helpers $scripts/helpers
set $menu    $helpers/fuzzel-menu.sh


# --- Autostart ---

# Внешний вид: generation engine проверяет/создаёт активное поколение и
# раскладывает стабильные файлы до старта waybar и первого запуска fuzzel/foot.
# Через sh: у скрипта после git clone/pull может не оказаться бита +x.
exec env SWAY_MINIMAL_ENSURE_NO_RELOAD=1 sh $scripts/look.sh ensure

# pkill и запуск обязательно в одном sh -c: два отдельных exec_always sway
# стартует параллельно, и pkill убивает только что поднятый waybar.
# Редирект в лог тоже обязателен — иначе waybar падает по SIGPIPE.
# ensure повторён в самой цепочке: exec выше и exec_always стартуют
# параллельно, и только так гарантировано, что theme.css/state.css созданы
# до старта waybar. Когда state-файлы на месте, ensure — мгновенный no-op.
exec_always sh -c 'SWAY_MINIMAL_ENSURE_NO_RELOAD=1 sh ~/.config/sway/scripts/look.sh ensure; killall -q swaync-client; killall -q waybar; sleep 0.2; exec waybar >/tmp/waybar.log 2>&1'

# Встроенного dwindle в sway нет: autotiling чередует направление split.
# Абсолютный путь, а не просто `autotiling`: sway стартует не через fish, поэтому
# ~/.local/bin (куда pipx кладёт бинарь) в PATH нет, и поиск по имени не срабатывает.
# sway выполняет exec через sh -c, поэтому $HOME раскрывается корректно.
# Не exec_always: при reload демон перезапускать не нужно — sway не убивает
# exec-процессы, а autotiling подписан на IPC, который переживает reload.
exec $HOME/.local/bin/autotiling

exec swaync
exec nm-applet --indicator
exec blueman-applet
# Графический диалог пароля для pkexec. polkit-gnome на Sway/Wayland падает.
exec lxpolkit
exec wl-paste --type text  --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec $scripts/wallpaper.sh ensure
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# 10 мин → блокировка, +30 с → экран гаснет. Если залочено вручную (Super+L),
# экран гаснет через 5 мин. Sway сам locker не поднимает — зовём lock.sh напрямую.
# Кавычки вокруг "*" обязательны: swayidle выполняет команды через sh -c.
exec swayidle -w \
    timeout 300 '(pgrep -x gtklock || pgrep -x swaylock) && swaymsg output "*" dpms off' resume 'swaymsg output "*" dpms on' \
    timeout 600 '$scripts/lock.sh -f' \
    timeout 630 'swaymsg output "*" dpms off'                      resume 'swaymsg output "*" dpms on' \
    before-sleep '$scripts/lock.sh -f'


# --- Look and feel ---

font pango:JetBrains Mono 11
default_border pixel 2
default_floating_border pixel 2
smart_borders on

# yes, не always: иначе клавиатурный фокус (Alt+Tab) отбивается окном под курсором.
# fuzzel-menu.sh на время меню ставит no, иначе fuzzel закрывается при уходе мыши.
focus_follows_mouse yes
mouse_warping container
seat * xcursor_theme Adwaita 24

#                       border  background text    indicator child_border
client.focused          #33ccff #33ccff    #ffffff #33ccff   #33ccff
client.focused_inactive #595959 #595959    #ffffff #595959   #595959
client.unfocused        #595959 #595959    #ffffff #595959   #595959
client.urgent           #ff0000 #ff0000    #ffffff #ff0000   #ff0000

# indicator = border: полоса «куда откроется следующее окно» отключена —
# отдельной опции у sway нет, а с gaps она выглядит как грань чужого цвета.

# Тема, толщина рамки и gaps подключаются из генерируемого файла (его пишет
# scripts/look.sh, в git он не лежит). Глоб, как с workspaces выше:
# без файла действуют значения из этого конфига.
include ~/.config/sway/look*

for_window [app_id="thunar" floating=true] move position center


# --- Input ---

input type:keyboard {
    xkb_layout "us,ru"
    xkb_options "grp:win_space_toggle"
}

input type:touchpad {
    natural_scroll enabled
    scroll_factor 0.5
    tap enabled
}

input type:pointer {
    accel_profile flat
    pointer_accel 0
}


# --- Keys ---
# --to-code: буквы и цифры работают при любой раскладке.

bindsym --to-code $mod+T exec $term
bindsym --to-code $mod+E exec $files
bindsym --to-code $mod+D exec $menu
bindsym --to-code $mod+Q kill
bindsym --to-code $mod+F exec $helpers/toggle-fullscreen.sh
bindsym --to-code $mod+B floating toggle
bindsym --to-code $mod+P sticky toggle
bindsym --to-code $mod+L exec $scripts/lock.sh
bindsym --to-code $mod+N exec pkill gammastep || gammastep -O 4500
bindsym --to-code $mod+Shift+N exec swaync-client -t -sw
bindsym --to-code $mod+V exec $helpers/clipboard-menu.sh
bindsym --to-code $mod+W exec $scripts/wallpaper.sh
bindsym --to-code $mod+bracketright exec $scripts/script_selector.sh
bindsym --to-code $mod+Shift+S exec grim -g "$(slurp)" - | wl-copy
bindsym --to-code $mod+Ctrl+S exec $scripts/screenshot.sh
bindsym --to-code Ctrl+$mod+Mod1+R reload
bindsym --to-code Ctrl+$mod+Mod1+m exec $scripts/toggle-monitors.sh
bindsym Ctrl+Mod1+Delete exec $scripts/powermenu.sh

floating_modifier $mod normal

# Круговой цикл по всем окнам workspace, включая плавающие.
bindsym Mod1+Tab       exec $helpers/cycle-windows.sh next
bindsym Mod1+Shift+Tab exec $helpers/cycle-windows.sh prev

# Переключение между существующими воркспейсами.
bindsym $mod+Tab       workspace next
bindsym $mod+Shift+Tab workspace prev

bindsym $mod+Left  focus left
bindsym $mod+Right focus right
bindsym $mod+Up    focus up
bindsym $mod+Down  focus down

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Down  move down

bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next

bindgesture swipe:3:left  workspace next
bindgesture swipe:3:right workspace prev

# Воркспейсы: $mod — перейти, +Shift — перенести окно и перейти, +Ctrl — молча.
# В конфиге sway нет циклов, поэтому 10 строк на группу — минимум возможного.
bindsym --to-code $mod+1 workspace number 1
bindsym --to-code $mod+2 workspace number 2
bindsym --to-code $mod+3 workspace number 3
bindsym --to-code $mod+4 workspace number 4
bindsym --to-code $mod+5 workspace number 5
bindsym --to-code $mod+6 workspace number 6
bindsym --to-code $mod+7 workspace number 7
bindsym --to-code $mod+8 workspace number 8
bindsym --to-code $mod+9 workspace number 9
bindsym --to-code $mod+0 workspace number 10

bindsym --to-code $mod+Shift+1 move container to workspace number 1, workspace number 1
bindsym --to-code $mod+Shift+2 move container to workspace number 2, workspace number 2
bindsym --to-code $mod+Shift+3 move container to workspace number 3, workspace number 3
bindsym --to-code $mod+Shift+4 move container to workspace number 4, workspace number 4
bindsym --to-code $mod+Shift+5 move container to workspace number 5, workspace number 5
bindsym --to-code $mod+Shift+6 move container to workspace number 6, workspace number 6
bindsym --to-code $mod+Shift+7 move container to workspace number 7, workspace number 7
bindsym --to-code $mod+Shift+8 move container to workspace number 8, workspace number 8
bindsym --to-code $mod+Shift+9 move container to workspace number 9, workspace number 9
bindsym --to-code $mod+Shift+0 move container to workspace number 10, workspace number 10

bindsym --to-code $mod+Ctrl+1 move container to workspace number 1
bindsym --to-code $mod+Ctrl+2 move container to workspace number 2
bindsym --to-code $mod+Ctrl+3 move container to workspace number 3
bindsym --to-code $mod+Ctrl+4 move container to workspace number 4
bindsym --to-code $mod+Ctrl+5 move container to workspace number 5
bindsym --to-code $mod+Ctrl+6 move container to workspace number 6
bindsym --to-code $mod+Ctrl+7 move container to workspace number 7
bindsym --to-code $mod+Ctrl+8 move container to workspace number 8
bindsym --to-code $mod+Ctrl+9 move container to workspace number 9
bindsym --to-code $mod+Ctrl+0 move container to workspace number 10


# --- Media keys ---

bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute     exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86AudioPrev        exec playerctl previous
bindsym --locked XF86AudioPlay        exec playerctl play-pause
bindsym --locked XF86AudioPause       exec playerctl play-pause
bindsym --locked XF86AudioNext        exec playerctl next

bindsym XF86MonBrightnessUp   exec $helpers/brightness.sh up
bindsym XF86MonBrightnessDown exec $helpers/brightness.sh down
